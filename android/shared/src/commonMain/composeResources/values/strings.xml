    <string-array name="desktop_guide">
        <item>ctrl+1, ctrl+2, ctrl+3|go to tasks, agenda or notes</item>
        <item>ctrl+n|a new task, event or note, in the part you are in</item>
        <item>up and down|choose a task, an event or a note</item>
        <item>enter|open it, or rename a task</item>
        <item>f2, or a double click|rename a task</item>
        <item>space|check or uncheck a task</item>
        <item>delete|move it to the bin</item>
        <item>ctrl+f|search the notes</item>
        <item>ctrl+,|the settings</item>
        <item>escape|close what is open</item>
        <item>a right click|everything else a row can do</item>
        <item>drag a task|onto the middle of another puts it inside, onto an edge puts it beside</item>
        <item>drag a note|put it somewhere else in the list</item>
        <item>closing the window|keeps planner in the tray, so reminders and sync go on. quit from the tray</item>
    </string-array>
    <string-array name="guide">
        <item>touch the dot on a task|change its priority</item>
        <item>hold a task, then swipe right|move it to the bin</item>
        <item>hold a task, then swipe left|rename it</item>
        <item>hold a task, then drag|move it: the middle of a task puts it inside, a line puts it above the task under the line</item>
        <item>touch a task while typing|add the next task inside it</item>
        <item>sweep sideways anywhere|switch tabs</item>
        <item>hold a note or an event, then swipe right|move it to its bin</item>
        <item>hold a note, then drag|put it somewhere else in the list</item>
        <item>hold any tab|open the settings</item>
        <item>sync, in the settings|pair another device: open sync on both, then scan or type the code of one on the other</item>
    </string-array>
