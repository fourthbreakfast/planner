<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Planner" parent="android:Theme.Material.Light.NoActionBar">
        <!-- what shows before the first frame and behind a moving screen is the page colour, in dark as in light -->
        <item name="android:windowBackground">@color/app_page</item>
    </style>

    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>