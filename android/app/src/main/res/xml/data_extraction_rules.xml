<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and moving to a new phone both carry the database and the few settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="view.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="view.xml" />
    </device-transfer>
</data-extraction-rules>
